# Base URL of the live CordChain FastAPI backend (run_api.sh serves it on :5000).
VITE_API_URL="http://localhost:5000"

# Demo/development Discord user used when running in a plain browser tab
# (outside the real Discord iframe). Replace with a real snowflake for testing.
VITE_DEMO_USER_ID="123456789012345678"
VITE_DEMO_USERNAME="CordTrader"
VITE_DEMO_GUILD_ID="111100000000000001"

